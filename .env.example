# Supabase > Connect : Transaction pooler (6543) pour le site sur Vercel.
# Le mot de passe doit être encodé pour une URL.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require"
# Session pooler (5432) pour les migrations Prisma.
DIRECT_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
ADMIN_EMAIL="stan@example.com"
ADMIN_PASSWORD_HASH="$2b$12$replace_me"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_SITE_URL="https://lepoole-electric.fr"
NEXT_PUBLIC_PHONE="+33100000000"
NEXT_PUBLIC_EMAIL="contact@lepoole-electric.fr"

# Photos privées des demandes de devis (Supabase Storage)
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_QUOTE_BUCKET="quote-requests"
