generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id                Int      @id @default(1)
  companyName       String   @default("Le Poole Electric")
  founderName       String   @default("Stan Le Poole")
  foundedYear       Int      @default(2002)
  phone             String?
  email             String?
  address           String?
  heroTitle         String   @default("Électricien à Triel-sur-Seine depuis 2002")
  heroSubtitle      String   @default("Dépannage, rénovation, tableaux électriques, domotique et installations connectées dans la vallée de la Seine.")
  googleReviewUrl   String?
  googleRating      Float?
  googleReviewCount Int      @default(1)
  updatedAt         DateTime @updatedAt
}

model City {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  title     String
  intro     String    @db.Text
  content   String    @db.Text
  isPrimary Boolean   @default(false)
  sortOrder Int       @default(0)
  published Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Service {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  title     String
  excerpt   String    @db.Text
  content   String    @db.Text
  sortOrder Int       @default(0)
  published Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  cityId      Int
  serviceId   Int?
  problem     String   @db.Text
  workDone    String   @db.Text
  result      String   @db.Text
  beforeImage String?
  afterImage  String?
  published   Boolean  @default(true)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  city        City     @relation(fields: [cityId], references: [id])
  service     Service? @relation(fields: [serviceId], references: [id])
}

model DocumentSequence {
  id        String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model QuoteRequest {
  id             String                   @id @default(cuid())
  number         String                   @unique
  customerName   String
  customerEmail  String
  customerPhone  String
  address        String
  postalCode     String?
  city           String?
  workType       QuoteRequestWorkType
  buildingAge    BuildingAge              @default(UNKNOWN)
  description    String                   @db.Text
  urgency        QuoteUrgency             @default(NORMAL)
  availability   String?                  @db.Text
  status         QuoteRequestStatus       @default(NEW)
  rgpdConsentAt  DateTime
  photos         QuoteRequestPhoto[]
  quotes         Quote[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([status, createdAt])
}

model QuoteRequestPhoto {
  id          String       @id @default(cuid())
  requestId   String
  storagePath String
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  request     QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model ServiceCatalog {
  id           Int              @id @default(autoincrement())
  name         String
  description  String?          @db.Text
  category     String?
  unit         ServiceUnit      @default(UNIT)
  unitPriceHT  Decimal          @db.Decimal(10, 2)
  costPriceHT  Decimal?         @db.Decimal(10, 2)
  active       Boolean          @default(true)
  sortOrder    Int              @default(0)
  taxRules     ServiceTaxRule[]
  quoteItems   QuoteItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([active, category, sortOrder])
}

model ServiceTaxRule {
  id        Int            @id @default(autoincrement())
  serviceId Int
  context   TaxContext
  taxRate   Decimal        @db.Decimal(5, 2)
  service   ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, context])
}

model Quote {
  id                         String       @id @default(cuid())
  number                     String       @unique
  requestId                  String?
  customerName               String
  customerEmail              String
  customerPhone              String?
  workAddress                String
  postalCode                 String?
  city                       String?
  taxContext                 TaxContext   @default(OTHER)
  status                     QuoteStatus  @default(DRAFT)
  validUntil                 DateTime?
  notes                      String?      @db.Text
  paymentTerms               String?      @db.Text
  depositPercent             Decimal?     @db.Decimal(5, 2)
  subtotalHT                 Decimal      @default(0) @db.Decimal(12, 2)
  taxAmount                  Decimal      @default(0) @db.Decimal(12, 2)
  totalTTC                   Decimal      @default(0) @db.Decimal(12, 2)
  token                      String       @unique @default(uuid())
  taxCertificationRequired   Boolean      @default(false)
  taxCertificationAcceptedAt DateTime?
  taxCertificationName       String?
  acceptedAt                 DateTime?
  rejectedAt                 DateTime?
  request                    QuoteRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  items                      QuoteItem[]
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([requestId])
}

model QuoteItem {
  id          String          @id @default(cuid())
  quoteId     String
  serviceId   Int?
  description String
  quantity    Decimal         @default(1) @db.Decimal(10, 2)
  unit        ServiceUnit     @default(UNIT)
  unitPriceHT Decimal         @db.Decimal(10, 2)
  costPriceHT Decimal?        @db.Decimal(10, 2)
  taxRate     Decimal         @db.Decimal(5, 2)
  totalHT     Decimal         @db.Decimal(12, 2)
  totalTax    Decimal         @db.Decimal(12, 2)
  totalTTC    Decimal         @db.Decimal(12, 2)
  position    Int             @default(0)
  quote       Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service     ServiceCatalog? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([quoteId, position])
}

enum QuoteRequestStatus {
  NEW
  REVIEWING
  QUOTED
  ARCHIVED
}

enum QuoteUrgency {
  NORMAL
  SOON
  URGENT
}

enum QuoteRequestWorkType {
  TROUBLESHOOTING
  RENOVATION
  NEW_CONSTRUCTION
  ENERGY_RENOVATION
  EXTENSION
  OTHER
}

enum BuildingAge {
  UNKNOWN
  UNDER_2_YEARS
  OVER_2_YEARS
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ServiceUnit {
  UNIT
  HOUR
  METER
  M2
  FORFAIT
  DAY
}

enum TaxContext {
  NEW_CONSTRUCTION
  RENOVATION_OVER_2_YEARS
  RENOVATION_UNDER_2_YEARS
  ENERGY_RENOVATION
  OTHER
}
