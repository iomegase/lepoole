{
  "name": "le-poole-electric",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node --env-file-if-exists=.env scripts/prisma-cli.mjs migrate dev",
    "prisma:deploy": "node --env-file-if-exists=.env scripts/prisma-cli.mjs migrate deploy",
    "prisma:seed": "tsx --env-file=.env prisma/seed.ts",
    "admin:reset-password": "python3 scripts/reset-admin-password.py"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "postcss": "^8.5.28",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
