generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteSettings {
  id              Int      @id @default(1)
  companyName     String   @default("Le Poole Electric")
  founderName     String   @default("Stan Le Poole")
  foundedYear     Int      @default(2002)
  phone           String?
  email           String?
  address         String?
  heroTitle       String   @default("Électricien à Triel-sur-Seine depuis 2002")
  heroSubtitle    String   @default("Dépannage, rénovation, tableaux électriques, domotique et installations connectées dans la vallée de la Seine.")
  googleReviewUrl String?
  googleRating    Float?
  googleReviewCount Int    @default(1)
  updatedAt       DateTime @updatedAt
}

model City {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  title       String
  intro       String   @db.Text
  content     String   @db.Text
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projects    Project[]
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  title       String
  excerpt     String   @db.Text
  content     String   @db.Text
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projects    Project[]
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  cityId      Int
  serviceId   Int?
  problem     String   @db.Text
  workDone    String   @db.Text
  result      String   @db.Text
  beforeImage String?
  afterImage  String?
  published   Boolean  @default(true)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  city        City     @relation(fields: [cityId], references: [id])
  service     Service? @relation(fields: [serviceId], references: [id])
}
